PORT=3000
BIND_HOST=127.0.0.1
DATA_DIR=./data
LOCAL_HOSTS=localhost:3000,127.0.0.1:3000,[::1]:3000
REQUEST_MAX_BYTES=5242880
FILE_MAX_BYTES=4194304
PDF_MAX_PAGES=40
DOCX_MAX_ENTRIES=128
DOCX_MAX_UNCOMPRESSED_BYTES=8388608
EXTRACTION_TIMEOUT_MS=5000
FETCH_MAX_REDIRECTS=3
FETCH_MAX_BYTES=524288
FETCH_TIMEOUT_MS=5000

